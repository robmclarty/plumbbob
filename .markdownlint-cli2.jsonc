{
  // Plumbbob docs are hand-written prose and templates. Disable the rules that
  // fight prose wrapping and the HTML-comment headers the templates open with;
  // keep the structural rules that catch real markdown mistakes.
  "config": {
    "default": true,
    "MD013": false, // line-length — prose and tables wrap freely
    "MD033": false, // inline HTML — templates open with <!-- ... --> guidance
    "MD036": false, // emphasis-as-heading — templates use *(italic guidance)* sub-text
    "MD040": false, // fenced-code-language — architecture sketches are language-less ascii
    "MD041": false, // first-line-heading — templates open with an HTML comment
    "MD060": false // table-column-style — table pipes need not be visually aligned
  },
  "globs": ["**/*.md"],
  // `.plumbbob/**`: build records are mechanically-appended artifacts, not prose —
  // the old `markdownlint-cli` glob never reached dot-directories either.
  "ignores": ["**/node_modules/**", "research/**", "dist/**", ".check/**", ".plumbbob/**"]
}
