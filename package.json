{
  "name": "plumbbob",
  "version": "0.6.6",
  "description": "Attention-first build process: 12 skills + a CLI that keep you the decider — guidance, not enforcement.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "cli",
    "agent",
    "attention-first"
  ],
  "homepage": "https://github.com/robmclarty/plumbbob#readme",
  "bugs": "https://github.com/robmclarty/plumbbob/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/plumbbob.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rob McLarty <hello@robmclarty.com>",
  "bin": {
    "plumbbob": "bin/plumbbob",
    "pb": "bin/pb"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "dist",
    "hooks",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run clean && pnpm run build",
    "check": "checkride",
    "test": "vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.43.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "fallow": "^2.103.0",
    "markdownlint-cli2": "^0.22.1",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "checkride": "0.3.0"
  },
  "bundleDependencies": [
    "checkride"
  ]
}
