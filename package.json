{
  "name": "plumbbob",
  "version": "0.10.0",
  "description": "Attention-first build process: 12 skills + a CLI that keep you the decider — guidance on the work, a latch on the record.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "cli",
    "agent",
    "attention-first"
  ],
  "homepage": "https://robmclarty.github.io/plumbbob/",
  "bugs": "https://github.com/robmclarty/plumbbob/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/plumbbob.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rob McLarty <hello@robmclarty.com>",
  "bin": {
    "plumbbob": "bin/plumbbob",
    "pb": "bin/pb"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "dist",
    "hooks",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run clean && pnpm run build",
    "check": "checkride",
    "test": "vitest run",
    "eval:baseline": "pnpm build && node test/evals/run.ts --sweep baseline",
    "eval:latched": "pnpm build && node test/evals/run.ts --sweep latched",
    "eval:report": "node test/evals/run.ts --report"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.1",
    "@stryker-mutator/api": "9.6.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vvago/vale": "3.17.1",
    "fallow": "3.14.0",
    "fascicle": "0.8.16",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "checkride": "0.12.2"
  },
  "bundleDependencies": [
    "checkride"
  ]
}
