{
  "name": "plumbbob",
  "version": "0.15.0",
  "description": "Attention-first build process: 18 skills, four hooks, and a CLI that keep you the decider. Guidance on the work, a latch on the record.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "cli",
    "agent",
    "attention-first"
  ],
  "homepage": "https://robmclarty.github.io/plumbbob/",
  "bugs": "https://github.com/robmclarty/plumbbob/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/plumbbob.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rob McLarty <hello@robmclarty.com>",
  "bin": {
    "plumbbob": "bin/plumbbob",
    "pb": "bin/pb"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "dist",
    "hooks",
    "skills",
    "templates"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run clean && pnpm run build",
    "check": "checkride",
    "test": "vitest run",
    "eval:baseline": "pnpm build && node test/evals/run.ts --sweep baseline",
    "eval:latched": "pnpm build && node test/evals/run.ts --sweep latched",
    "eval:report": "node test/evals/run.ts --report",
    "size:prose": "node scripts/count-prose.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.1",
    "@robmclarty/keyframes": "0.3.0",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vvago/vale": "3.25.1",
    "cspell": "10.4.0",
    "fallow": "3.38.1",
    "fascicle": "0.17.8",
    "markdownlint-cli2": "0.24.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "checkride": "0.20.0"
  },
  "bundleDependencies": [
    "checkride"
  ]
}
