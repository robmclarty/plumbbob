{
  // Publish build: the base config is noEmit (type-check + native strip only).
  // This one emits runnable JS to dist/ so the published `bin` does not need tsx
  // or Node type-stripping on the user's machine. rewriteRelativeImportExtensions
  // turns the `.ts` import specifiers into `.js` in the output; rootDir pins the
  // layout so dist/ mirrors src/ (verbs resolve hooks/skills/templates via ../../).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // tsc emits by default even when it reports errors, and a failing build here
    // writes its output relative to whatever rootDir resolved to. A probe with a
    // bad rootDir on 2026-08-12 scattered 33 .js files through src/ that way, which
    // only the `dead` slot noticed. A publish build that errored should produce
    // nothing at all, so errors stop the emit.
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
