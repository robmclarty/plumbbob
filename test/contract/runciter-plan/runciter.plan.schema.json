{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "runciter.plan/1"
    },
    "build": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "source": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "depends_on": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seam": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stop": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "planned",
              "structural"
            ]
          },
          "effort": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "done_when": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "seam",
          "done_when"
        ]
      }
    }
  },
  "required": [
    "protocol",
    "build",
    "steps"
  ]
}
